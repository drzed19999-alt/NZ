# ─────────────────────────────────────────────────────────────
# CRM + Admin Panel — environment configuration
# Copy to .env.local (dev) or set in your host (prod). Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- Supabase (the CRM's OWN database — separate from vtmarkets) ---
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Full access; bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- vtmarkets crypto platform integration (server-to-server) ---
# Base URL of the vtmarkets backend (vtmarkets/server).
CRYPTO_PLATFORM_API_URL=http://localhost:4000
# Must equal the vtmarkets server's CRM_API_KEY.
CRYPTO_PLATFORM_API_KEY=replace-with-a-long-random-integration-key
# Seconds to cache per-investor snapshots pulled from the platform API.
INVESTOR_CACHE_TTL_SECONDS=60

# --- Inbound webhooks FROM vtmarkets ---
# Must equal the vtmarkets server's CRM_WEBHOOK_SECRET (used to verify HMAC).
PLATFORM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# --- Meta (Facebook) Lead Ads integration (optional) ---
# Leave blank to run the CRM without Meta — manual leads still work.
META_APP_SECRET=
# Token you choose; also entered in the Meta webhook setup UI.
META_VERIFY_TOKEN=set-a-verify-token
# Long-lived Page access token used to fetch lead details from the Graph API.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v20.0

# --- Email (sending to leads/users from the CRM) ---
# Provider-agnostic SMTP. If unset, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VT Markets CRM <crm@vtmarkets.example>"

# --- App ---
# Public base URL of this CRM (used in links / redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Configurable alert thresholds
ALERT_LARGE_TXN_THRESHOLD=25000
ALERT_DORMANT_DAYS=14
ALERT_KYC_SLA_HOURS=48
