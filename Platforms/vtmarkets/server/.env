# ─────────────────────────────────────────────────────────────
# VT Markets backend — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the vtmarkets frontend).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Database (Supabase Postgres or any Postgres) ---
# Supabase: Project Settings → Database → Connection string (URI). Use the
# "Session"/pooler string for serverless, direct string for a long-running server.
DATABASE_URL=postgresql://postgres.deumycadyoylsetxfirj:LA@F26aMSPa-xvj@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Set to "true" for hosted Postgres that requires TLS (Supabase does).
DATABASE_SSL=true

# --- Customer auth (JWT for the vtmarkets frontend) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=01a976429e774df21e1dd9861f71e32c9ae8017f6415a860f382de3a00f3a7b0fda350b6a59530fc97db7a479360ed2c
JWT_EXPIRES_IN=7d

# How recently a user must have hit the API to count as "online" (minutes).
PRESENCE_ONLINE_WINDOW_MINUTES=5

# --- Secure CRM integration API ---
# The CRM authenticates to /api/integration/* with this key (Bearer or X-API-Key).
# Generate a strong random value and give the SAME value to the CRM as
# CRYPTO_PLATFORM_API_KEY.
CRM_API_KEY=c90ba80b864e9f1479276004e982a593ca6f13a3aaf49bc60a4578eaf4391b0b0384f713b2c5eba2fc3a12c7a2806295

# --- Outbound webhooks (vtmarkets -> CRM) ---
# Where to POST platform events (deposits, withdrawals, logins, KYC changes).
# Leave blank to disable outbound webhooks.
CRM_WEBHOOK_URL=http://localhost:3000/api/webhooks/platform
# Shared secret used to HMAC-sign webhook payloads (X-VT-Signature header).
# Must match the CRM's PLATFORM_WEBHOOK_SECRET.
CRM_WEBHOOK_SECRET=60fc801a5dacaf8f031f71341dcadb0410e6cb2ff2054545fa4e180782104ee0987d2a6222e87f5a52ff122d7ac6bb4a


# --- Email (optional; account activation / notifications) ---
# If unset, activation links are logged to the console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VT Markets <no-reply@vtmarkets.example>"

# Base URL of the frontend, used to build activation links.
FRONTEND_BASE_URL=http://localhost:5500
