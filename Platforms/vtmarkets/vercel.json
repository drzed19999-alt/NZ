{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/activate", "destination": "/activate.html" },
    { "source": "/change-password", "destination": "/change-password.html" },
    { "source": "/payment-success", "destination": "/payment-success.html" },
    { "source": "/payment-failed", "destination": "/payment-failed.html" },
    { "source": "/verify-3ds", "destination": "/verify-3ds.html" },
    { "source": "/verify-otp", "destination": "/verify-otp.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
